APP_NAME="CIAAAA POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANT (prod): set APP_URL to the PUBLIC dashboard domain (https). Uploaded
# product/QRIS image URLs are built from this and must be reachable by the mobile app.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Prod (behind TLS proxy): force https URLs + secure cookies.
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Images are hosted on the local "public" disk (run `php artisan storage:link`).
# Persist storage/app/public across deploys (mount as a volume on Dokploy).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CIAAAA POS API (single source of truth for all domain data).
POS_API_BASE_URL=https://cpos-api.kuadrattech.my.id/v1
POS_API_TIMEOUT=15
POS_API_CONNECT_TIMEOUT=5
POS_API_RETRY_TIMES=2
POS_API_RETRY_SLEEP_MS=200
